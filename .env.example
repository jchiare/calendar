# Managed Postgres (created by the Vercel Neon integration or copied from Neon)
DATABASE_URL=postgresql://...

# Better Auth (`openssl rand -base64 32`; use the public deployment URL)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional: OpenRouter (create an API key in the OpenRouter dashboard)
OPENROUTER_API_KEY=
OPENROUTER_IEP_MODEL=openai/gpt-5.4
OPENROUTER_SUMMARY_MODEL=openai/gpt-5.4-mini
OPENROUTER_PLANNING_MODEL=openai/gpt-5.4

# Optional: Resend (API key plus a sender on a verified domain)
RESEND_API_KEY=
EMAIL_FROM=Sayso <hello@example.com>

# Optional: created when a Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Optional: `openssl rand -hex 32`
CRON_SECRET=
